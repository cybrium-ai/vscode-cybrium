{
  "name": "cybrium",
  "displayName": "Cybrium Security Scanner",
  "description": "Real-time SAST, SCA, and secrets detection powered by cyscan — 1,067 rules across 19 languages",
  "version": "0.1.0",
  "publisher": "cybrium-ai",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/cybrium-ai/vscode-cybrium"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Linters", "Programming Languages", "Other"],
  "keywords": ["security", "sast", "sca", "secrets", "vulnerability", "cyscan", "cybrium"],
  "activationEvents": [
    "onLanguage:python",
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:go",
    "onLanguage:java",
    "onLanguage:ruby",
    "onLanguage:php",
    "onLanguage:rust",
    "onLanguage:c",
    "onLanguage:cpp",
    "onLanguage:csharp",
    "onLanguage:terraform",
    "onLanguage:dockerfile",
    "onLanguage:yaml",
    "onLanguage:json",
    "onLanguage:shellscript"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cybrium.scanFile",
        "title": "Cybrium: Scan Current File"
      },
      {
        "command": "cybrium.scanWorkspace",
        "title": "Cybrium: Scan Workspace"
      },
      {
        "command": "cybrium.openDashboard",
        "title": "Cybrium: Open Dashboard"
      },
      {
        "command": "cybrium.explain",
        "title": "Cybrium: Explain Vulnerability"
      },
      {
        "command": "cybrium.fixAll",
        "title": "Cybrium: Fix All Findings in File"
      },
      {
        "command": "cybrium.aiFixFile",
        "title": "Cybrium: AI Fix — Generate Fix for Current File"
      }
    ],
    "configuration": {
      "title": "Cybrium",
      "properties": {
        "cybrium.autoScan": {
          "type": "boolean",
          "default": true,
          "description": "Automatically scan files on save"
        },
        "cybrium.cyscanPath": {
          "type": "string",
          "default": "",
          "description": "Path to cyscan binary (auto-detected if empty)"
        },
        "cybrium.apiUrl": {
          "type": "string",
          "default": "https://app.cybrium.ai",
          "description": "Cybrium platform URL for dashboard links"
        },
        "cybrium.apiKey": {
          "type": "string",
          "default": "",
          "description": "API key for platform integration (optional)"
        },
        "cybrium.severityFilter": {
          "type": "string",
          "default": "info",
          "enum": ["critical", "high", "medium", "low", "info"],
          "description": "Minimum severity to show"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0",
    "@vscode/vsce": "^2.22.0"
  }
}
