{
  "name": "cybrium",
  "displayName": "Cybrium Security Scanner",
  "description": "Real-time SAST, SCA, secrets, K8s, endpoint, app package scanning, license compliance — 1,815 rules + CIA posture scoring across 75+ languages. Scan .app, .ipa, .apk, .exe, .deb, .rpm. Plus active discovery of self-hosted AI inference servers (Ollama, vLLM, TGI, Triton, LM Studio). Powered by cyscan + cyweb + cyradar.",
  "version": "0.6.0",
  "publisher": "cybrium-ai",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/cybrium-ai/vscode-cybrium"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Linters", "Programming Languages", "Other"],
  "keywords": ["security", "sast", "sca", "secrets", "vulnerability", "cyscan", "cyweb", "cyradar", "cybrium", "web-scanner", "dast", "ai-security", "ai-inventory", "ollama", "vllm", "llm"],
  "activationEvents": [
    "onLanguage:python", "onLanguage:javascript", "onLanguage:typescript",
    "onLanguage:go", "onLanguage:java", "onLanguage:ruby", "onLanguage:php",
    "onLanguage:rust", "onLanguage:c", "onLanguage:cpp", "onLanguage:csharp",
    "onLanguage:terraform", "onLanguage:dockerfile", "onLanguage:yaml",
    "onLanguage:json", "onLanguage:shellscript"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      { "command": "cybrium.scanFile", "title": "Cybrium: Scan Current File" },
      { "command": "cybrium.scanWorkspace", "title": "Cybrium: Scan Workspace" },
      { "command": "cybrium.openDashboard", "title": "Cybrium: Open Dashboard" },
      { "command": "cybrium.explain", "title": "Cybrium: Explain Vulnerability" },
      { "command": "cybrium.fixAll", "title": "Cybrium: Fix All Findings in File" },
      { "command": "cybrium.aiFixFile", "title": "Cybrium: AI Fix — Generate Fix for Current File" },
      { "command": "cybrium.webScan", "title": "Cybrium: Web Scan — Scan URL for vulnerabilities (SQLi, XSS, SSRF, 22 categories)" },
      { "command": "cybrium.repoHealth", "title": "Cybrium: Repository Health Check (14 checks, 0-100 score)" },
      { "command": "cybrium.detectFrameworks", "title": "Cybrium: Detect Frameworks (35 frameworks, 9 languages)" },
      { "command": "cybrium.discoverAITools", "title": "Cybrium: Discover AI Tools on This Machine (cyradar local-scan)" },
      { "command": "cybrium.discoverAIServers", "title": "Cybrium: Discover AI Servers on Network… (cyradar discover)" }
    ],
    "configuration": {
      "title": "Cybrium",
      "properties": {
        "cybrium.autoScan": { "type": "boolean", "default": true, "description": "Automatically scan files on save" },
        "cybrium.cyscanPath": { "type": "string", "default": "", "description": "Path to cyscan binary (auto-detected if empty)" },
        "cybrium.apiUrl": { "type": "string", "default": "https://app.cybrium.ai", "description": "Cybrium platform URL" },
        "cybrium.apiKey": { "type": "string", "default": "", "description": "API key for AI Fix and platform features" },
        "cybrium.severityFilter": { "type": "string", "default": "info", "enum": ["critical", "high", "medium", "low", "info"], "description": "Minimum severity to show" }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0",
    "@vscode/vsce": "^2.22.0"
  }
}
